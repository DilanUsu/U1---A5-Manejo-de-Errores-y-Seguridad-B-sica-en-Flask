# Copia este archivo como .env y ajusta los datos (NO subas .env a GitHub)
# Sin DATABASE_URL se usa SQLite (instance/videojuegos.db)
# DATABASE_URL=mysql+pymysql://usuario:password@localhost/videojuegos

# DSN de tu proyecto en sentry.io (Settings > Client Keys). Si se deja vacio, Sentry no se activa.
SENTRY_DSN=
